# 把本文件复制一份，改名为 .env，然后填入你自己的 key。
# .env 已经在 .gitignore 里，不会被提交到 GitHub。

# ---------- 模型：DeepSeek ----------
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ---------- 搜索：二选一 ----------
# 用哪家：tavily（国外，推荐先用它试）| bocha（国内中文）| mock（假搜索，调试用）
SEARCH_PROVIDER=tavily

# Tavily：申请 https://app.tavily.com   每月 1000 次免费，不用信用卡
TAVILY_API_KEY=

# 博查（中文搜索，国内直连）：申请见 https://open.bochaai.com
BOCHA_API_KEY=
# BOCHA_ENDPOINT=https://api.bochaai.com/v1/web-search

# ---------- 成本控制 ----------
# 一次最多核查几条断言（每条断言 = 最多 3 次搜索 + 更多 token）
MAX_CLAIMS=3
# 每种语言的搜索取几条（中文一遍、英文一遍）
MAX_RESULTS=4
# 每条断言最终保留几条证据。证据按来源等级取舍：A/B 级优先占位，弱来源被挤掉。
# 这个值是控制成本的关键（双语搜索会让候选变多，但保留数不变）。
MAX_EVIDENCE=6

# ---------- 时效 ----------
# 涉及近期事件（"今年""最近""昨天"）的断言，额外走一次新闻搜索，只取最近 N 天的新闻。
# 设 0 关闭。实测新闻模式（topic=news + days）有效，结果带发布时间。
NEWS_DAYS=30

# 检索/结果缓存天数。作用有三个：① 同一段文字重复查询结果完全一致
# ② 第二次查完全免费 ③ 省搜索额度。设 0 关闭缓存（关闭后同一段文字可能给出不同答案）
CACHE_DAYS=7

# 判定跑几次取多数（self-consistency）。
# 实测：证据固定时判定是稳定的，所以默认 1 次就够；
# 对特别要紧的内容可以设 3（成本约翻 1.5 倍）。
JUDGE_VOTES=1

# ---------- 全文抓取 ----------
# 搜索只返回摘要片段，关键限定词（"但孕妇禁用"这类）常常不在摘要里。
# 打开后，对**够格下结论的来源**（默认 A/B 级）再抓一次网页正文，让模型看原文。
# 注意：这会让判定那一步的 token 明显变多（每页 3000 字 × 最多 3 页 × 每条断言）。
FULLTEXT=1

# 走哪条通道抓正文：
#   auto   = 有 TAVILY_API_KEY 就用 Tavily /extract，否则退回免费 http（默认）
#   tavily = Tavily /extract：质量最好，能处理 JS 渲染页和 PDF，约 1 credit / 5 个网页
#   http   = 直接拉网页剥标签：完全免费，但 JS 渲染的站点抓不到、PDF 不支持
#   off    = 不抓（等同 FULLTEXT=0）
FULLTEXT_PROVIDER=auto

# 每条断言最多抓几页全文；每页正文最多留多少字
FULLTEXT_MAX=3
FULLTEXT_CHARS=3000

# 只对这些等级的来源抓全文（C/D 级本来只能当线索，给它们抓全文是白烧 token）
FULLTEXT_TIERS=A,B

# 单个网页抓取超时（秒）
FULLTEXT_TIMEOUT=20

# ---------- 检索范围 ----------
# 「辟谣路」的站点定向。只作用于关键词带「辟谣 真相 / fact check」的那一路。
#
# ⚠️ 实测（2026-10-08）：Tavily 的 include_domains 是**硬过滤**，不是加权 ——
#    给一个不存在的域名返回 0 条，连给 gov.cn 配辟谣查询也是 0 条。
#    所以它只适合用在"命脉清楚"的这一路：辟谣路本来就只想要辟谣平台的结果，
#    而且它空了还有中文/英文/新闻三路兜底，不会把整条核查拖垮。
#    对中文/英文路做定向 = 拿召回换精准，风险大得多，不要那么用。
#
# 效果实测（查询「低钠盐是送命盐 辟谣 真相」）：
#    不限定 -> 6 条里只有 1 条来自辟谣平台（其余是新浪、知乎、某医院…）
#    限定后 -> 3 条**全部**来自 piyao.org.cn / piyao.kepuchina.cn
# kepuchina.cn 会自动覆盖 piyao.kepuchina.cn 等子域。
# 留空 = 关闭定向。
FACT_CHECK_DOMAINS=piyao.org.cn,kepuchina.cn,fact.qq.com

# 排除内容农场 / 门户转载。逗号分隔，留空 = 不排除。
# 有效的机制是**腾出结果位**：max_results 是固定的 4~5 个位子，
# 垃圾占一个就少一个权威来源。实测（2026-10-08）低钠盐那条查询，
# 排除前 A/B 级来源 1/5，排除后 2/5（挤进了辟谣平台和人民网）。
EXCLUDE_DOMAINS=baijiahao.baidu.com,csdn.net,jianshu.com,sohu.com,163.com,toutiao.com,ifeng.com

# ---------- 刻意不用的 Tavily 参数（都实测过，记在这里免得以后又加回来）----------
# country    —— 实测让一条中文政策查询的**结果变差**：基线给的是 5 个中国政府站
#               （全是 A 级），加上 country=china 之后混进了百度百科（D 级）和
#               保险公司官网。而且值写错（如 "cn"）会让整个请求 HTTP 400。
# auto_parameters —— 会让 Tavily 按它的判断替我们改 search_depth 之类的参数。
#               这个项目最讲究"知道自己到底发了什么请求"，不能让它擅自改。
# /research  —— 自主多轮研究、**直接给结论**。和本项目"只信一手来源、自己分级、
#               模型不许凭记忆下结论"的哲学正面冲突，而且 4~250 credit 一次。
# search_depth=advanced —— 我们已经**自己抓网页正文**了，它带来的"内容更长"
#               价值已被覆盖，而价格翻倍（2 credit/次）。
