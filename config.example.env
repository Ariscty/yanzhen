# 把本文件复制一份，改名为 .env，然后填入你自己的 key。
# .env 已经在 .gitignore 里，不会被提交到 GitHub。

# ---------- 模型：DeepSeek ----------
# 申请：https://platform.deepseek.com/
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# ---------- 搜索：二选一 ----------
# 用哪家：tavily（国外，推荐先用它试）| bocha（国内中文）| mock（假搜索，调试用）
SEARCH_PROVIDER=tavily

# Tavily：申请 https://app.tavily.com   每月 1000 次免费，不用信用卡
TAVILY_API_KEY=

# 博查（中文搜索，国内直连）：申请见 https://open.bochaai.com
BOCHA_API_KEY=
# BOCHA_ENDPOINT=https://api.bochaai.com/v1/web-search

# ---------- 成本控制 ----------
# 一次最多核查几条断言（每条断言 = 最多 3 次搜索 + 更多 token）
MAX_CLAIMS=3
# 每种语言的搜索取几条（中文一遍、英文一遍）
MAX_RESULTS=4
# 每条断言最终保留几条证据。证据按来源等级取舍：A/B 级优先占位，弱来源被挤掉。
# 这个值是控制成本的关键（双语搜索会让候选变多，但保留数不变）。
MAX_EVIDENCE=6

# ---------- 时效 ----------
# 涉及近期事件（"今年""最近""昨天"）的断言，额外走一次新闻搜索，只取最近 N 天的新闻。
# 设 0 关闭。实测新闻模式（topic=news + days）有效，结果带发布时间。
NEWS_DAYS=30

# 检索/结果缓存天数。作用有三个：① 同一段文字重复查询结果完全一致
# ② 第二次查完全免费 ③ 省搜索额度。设 0 关闭缓存（关闭后同一段文字可能给出不同答案）
CACHE_DAYS=7

# 判定跑几次取多数（self-consistency）。
# 实测：证据固定时判定是稳定的，所以默认 1 次就够；
# 对特别要紧的内容可以设 3（成本约翻 1.5 倍）。
JUDGE_VOTES=1
