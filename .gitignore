# 密钥与敏感文件 —— 绝对不能提交！
.env
.env.local
*.key
*.pem

# 缓存 / 运行产物
cache_search.json
cache_result.json
cache_claims.json
cache_fetch.json
eval/*.partial.json
eval/*.smoke.md

# 商店打包产物（用 store/pack.py 重新生成即可，不入库）
dist/
*.zip

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
out/

# Windows 自己长出来的垃圾：某个进程没展开环境变量，把
# %SystemDrive%\ProgramData\...\Caches 写到了当前工作目录。
# 删掉还会再回来，所以直接忽略，别让它污染 git status。
%SystemDrive%/
